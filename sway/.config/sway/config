# Read `man 5 sway` for a complete reference.

# --- Noctalia ipc alias ------------------------------------------------
set $ipc noctalia msg

# --- Menu / clipboard / lock / notifications / screenshot --------------
set $menu $ipc panel-toggle launcher
set $clipboard $ipc panel-toggle clipboard
set $lock $ipc panel-toggle session
set $notifications $ipc panel-toggle control-center notifications
set $clearNotifications $ipc notification-clear-history
set $screenshot $ipc screenshot-region --annotate

# --- Audio -------------------------------------------------------------
set $audioUp $ipc volume-up
set $audioDown $ipc volume-down
set $audioMute $ipc volume-mute
set $micMute $ipc mic-mute

# --- Brightness --------------------------------------------------------
set $brightUp $ipc brightness-up
set $brightDown $ipc brightness-down

# --- Cursor ------------------------------------------------------------
seat seat0 xcursor_theme Adwaita 24

# --- Navigation --------------------------------------------------------
set $mod Mod4
set $left h
set $down j
set $up k
set $right l

# --- AZERTY number row -------------------------------------------------
set $one ampersand
set $two eacute
set $three quotedbl
set $four apostrophe
set $five parenleft
set $six minus
set $seven egrave
set $eight underscore
set $nine ccedilla
set $ten agrave

# --- Applications ------------------------------------------------------
set $files nautilus -w
set $term alacritty

# --- Focus & Decorations -----------------------------------------------
focus_wrapping no
focus_follows_mouse no
gaps inner 5
default_border pixel 3

# --- Includes ----------------------------------------------------------
include ./modules/input.conf
include ./modules/keybinds.conf
include ./modules/output.conf
include ./modules/swayfx.conf
include /etc/sway/config.d/*

# --- Autostart ---------------------------------------------------------
exec noctalia
exec wl-clip-persist --clipboard regular

# Auto appended by noctalia's sway template.
include ~/.config/sway/noctalia
